{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "assist": {
    "actions": {
      "source": {
        "preset": "recommended",
        "noDuplicateClasses": "on",
        "useSortedAttributes": "on",
        "useSortedEnumMembers": "on",
        "useSortedInterfaceMembers": "on",
        "useSortedKeys": "on",
        "useSortedPackageJson": "on",
        "useSortedProperties": "on"
      }
    },
    "enabled": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!!.wxt",
      "!!.output",
      "!!node_modules",
      "!!playwright-report",
      "!!test-report",
      "!!test-results",
      "!package.json",
      "!package-lock.json",
      "!release.json",
      "!.release-manifest.json",
      "!.github",
      "!**/*.md"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "nursery": {
        "noFloatingPromises": "error",
        "noJsonUnsafeValues": "error",
        "noMisusedPromises": "error",
        "noRestrictedDependencies": "error",
        "noUnsafePlusOperands": "error"
      },
      "style": {
        "noDefaultExport": "error",
        "noProcessEnv": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["./*", "../*"],
                "message": "Use `~/` for imports from `src` or `~~/` for root imports, relative imports are forbidden."
              }
            ]
          }
        },
        "useConsistentArrayType": {
          "level": "error",
          "options": {
            "syntax": "shorthand"
          }
        },
        "useConsistentCurlyBraces": "error",
        "useConsistentObjectDefinitions": {
          "level": "error",
          "options": {
            "syntax": "explicit"
          }
        },
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": {
            "style": "type"
          }
        },
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "filenameCases": ["kebab-case"]
          }
        },
        "useNamingConvention": {
          "level": "error",
          "options": {
            "strictCase": false
          }
        },
        "useSelfClosingElements": "error",
        "noInlineStyles": "error"
      },
      "suspicious": {
        "noDuplicateSelectors": "error",
        "noEmptyObjectKeys": "error",
        "noJsxLeakedDollar": "error",
        "noLoopFunc": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["biome.jsonc"],
      "assist": {
        "actions": {
          "source": {
            "useSortedKeys": "off"
          }
        }
      }
    },
    {
      "includes": ["wxt.config.ts", "playwright.config.ts", "src/entrypoints/**"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": ["playwright.config.ts"],
      "linter": {
        "rules": {
          "style": {
            "noProcessEnv": "off"
          }
        }
      }
    }
  ],
  "vcs": {
    "clientKind": "git",
    "enabled": true,
    "useIgnoreFile": true
  }
}
