{
	"version": "1.2.2",
	"private": true,
	"engines": {
		"node": ">=22.0.0"
	},
	"scripts": {
		"postinstall": "wxt prepare",
		"dev:firefox": "wxt -b firefox",
		"dev:chrome": "wxt -b chrome",
		"dev:safari": "wxt -b safari",
		"check": "tsc --noEmit && biome check",
		"check:fix": "tsc --noEmit && biome check --fix",
		"build": "wxt clean && wxt zip -b firefox --sources && wxt zip -b chrome && wxt zip -b safari",
		"test": "playwright install chromium && playwright test"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.4",
		"@playwright/test": "1.64.1",
		"@types/node": "26.6.6",
		"typescript": "7.0.2",
		"wxt": "0.21.5"
	}
}
